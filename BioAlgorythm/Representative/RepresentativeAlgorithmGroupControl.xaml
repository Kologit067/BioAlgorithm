<UserControl x:Class="BioAlgorithm.Representative.RepresentativeAlgorithmGroupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Representative"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="GroupGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                <Button Content="Refresh" Command="{Binding RefreshRepresentativeAlgorithmGroupListCommand}"/>
                <Label Content="Sort" Margin="15,1,5,1"/>
                <ComboBox Name="cbPerformanceOrder"  ItemsSource="{Binding AlgorithmGroupSortItems}"
                                  SelectedItem="{Binding AlgorithmGroupListSort}" IsEditable="true" IsReadOnly="true"/>
                <Button ToolTip="Delete" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.DeleteGroupCommand, ElementName=GroupGrid}" 
                                            CommandParameter="{Binding}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding RepresentativeAlgorithmGroupByDimensions}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedAlgorithmGroup}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="To Filter" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToFilterCommand, ElementName=GroupGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/document-export.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="To Filter By Group" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.ToFilterInGroupCommand, ElementName=GroupGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/eraser32.ico" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Open in Win" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.OpenInWindowCommand, ElementName=GroupGrid}" CommandParameter="{Binding}" >
                                        <Image Width="25" Height="25" Source="/Pictures/DOCL.ICO" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Delete" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.DeleteGroupCommand, ElementName=GroupGrid}" 
                                            CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/deleteTrackFromTheMap.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button ToolTip="Test isomorphism" Margin="1" Padding="1" 
                                            Command="{Binding Path=DataContext.TestIsomorphismCommand, ElementName=GroupGrid}" 
                                            CommandParameter="{Binding}">
                                        <Image Width="25" Height="25" Source="/Pictures/task4.png" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="NumberOfSet" Binding="{Binding NumberOfSet}" MinWidth="50"></DataGridTextColumn>
                    <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" MinWidth="50"></DataGridTextColumn>
                    <DataGridTextColumn Header="Step" Binding="{Binding Step}" MinWidth="100"></DataGridTextColumn>
                    <DataGridTextColumn Header="TotalCount" Binding="{Binding TotalCount}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="NumberOfIteration" Binding="{Binding NumberOfIteration}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="TotalDuration" Binding="{Binding TotalDuration}" MinWidth="200"></DataGridTextColumn>
                    <DataGridTextColumn Header="AverageDuration" Binding="{Binding AverageDuration}" MinWidth="200"></DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </Grid>
</UserControl>
