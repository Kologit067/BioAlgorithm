<UserControl x:Class="BioAlgorithm.Representative.RepresentativeAlgorithmWithGroupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BioAlgorithm.Representative"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RepresentativeGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"  Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="2" Content="Top" Margin="2"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding RepresentativesPerfomanceFilter.Top}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Column="0" Content="Sort" Margin="2"/>
                <ComboBox Grid.Column="1" Name="cbRPOrder"  ItemsSource="{Binding RepresentativePerformanceSortItems}"
                                  SelectedItem="{Binding SelectedRepresentativePerformanceSort}" IsEditable="true" IsReadOnly="true"/>
                <Label Grid.Column="4" Content="Group Column" Margin="2"/>
                <ComboBox Grid.Column="5" Name="cbGroupColumn"  ItemsSource="{Binding GroupColumnItems}"
                                  SelectedItem="{Binding SelectedGroupColumn}" IsEditable="true" IsReadOnly="true"/>
                <Button Grid.Column="7" Content="Refresh" Command="{Binding RefreshRepresentativePerformanceListCommand}"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Algorithm" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RepresentativesPerfomanceFilter.Algorithm}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Content="Dimension" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RepresentativesPerfomanceFilter.Dimension}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="4" Content="NumberOfSet" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding RepresentativesPerfomanceFilter.NumberOfSet}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="6" Content="Step" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding RepresentativesPerfomanceFilter.Step}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="0" Content="InputLen" Margin="2"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepresentativesPerfomanceFilter.InputLen}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="2" Content="InputLenSort" Margin="2"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RepresentativesPerfomanceFilter.InputLenSort}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="4" Content="IsComplete" Margin="2"/>
                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding RepresentativesPerfomanceFilter.IsComplete}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="0" Content="NumberOfIteration From" Margin="2"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RepresentativesPerfomanceFilter.NumberOfIterationFrom}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="2" Content="To" Margin="2"/>
                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding RepresentativesPerfomanceFilter.NumberOfIterationTo}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="4" Content="Duration From" Margin="2"/>
                <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding RepresentativesPerfomanceFilter.DurationFrom}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="6" Content="To" Margin="2"/>
                <TextBox Grid.Row="3" Grid.Column="7" Text="{Binding RepresentativesPerfomanceFilter.DurationTo}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="4" Grid.Column="0" Content="CountTermina lFrom" Margin="2"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RepresentativesPerfomanceFilter.CountTerminalFrom}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="4" Grid.Column="2" Content="To" Margin="2"/>
                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding RepresentativesPerfomanceFilter.CountTerminalTo}" Margin="2" VerticalContentAlignment="Center"/>
                <Label Grid.Row="4" Grid.Column="4" Content="BestValue" Margin="2"/>
                <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding RepresentativesPerfomanceFilter.BestValue}" Margin="2" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding Path=RepresentativePerformanceAsGroupList}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectedRepresentativePerformanceAsGroup}" IsSynchronizedWithCurrentItem="True"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding ColumnGroupName}" Binding="{Binding ColumnGroupValue}" MinWidth="200"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Column="1" ItemsSource="{Binding Path=RepresentativePerformanceAsGroupList/RepresentativesPerfomanceList}" IsReadOnly="false" AutoGenerateColumns="False" Margin="1"
                           AlternationCount="2" RowBackground="#DDDDFF" AlternatingRowBackground="#CCCCEE"
                           SelectedItem="{Binding SelectrdRepresentativeItem}"
                           SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Button Content="Make Graph" Margin="1" Padding="1" 
                                        Command="{Binding Path=DataContext.MakeGraphCommand, ElementName=RepresentativeGrid}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="NumberOfSet" Binding="{Binding NumberOfSet}" MinWidth="50"></DataGridTextColumn>
                        <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" MinWidth="50"></DataGridTextColumn>
                        <DataGridTextColumn Header="Step" Binding="{Binding Step}" MinWidth="80"></DataGridTextColumn>
                        <DataGridTextColumn Header="InputLen" Binding="{Binding InputLen}" MinWidth="100"></DataGridTextColumn>
                        <DataGridTextColumn Header="InputLenSort" Binding="{Binding InputLenSort}" MinWidth="100"></DataGridTextColumn>
                        <DataGridTextColumn Header="InputLenAvg" Binding="{Binding InputLenAvg}" MinWidth="50"></DataGridTextColumn>
                        <DataGridTextColumn Header="InputData" Binding="{Binding InputData}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="InputDataShort" Binding="{Binding InputDataShort}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="NumberOfIteration" Binding="{Binding NumberOfIteration}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="DurationMilliSeconds" Binding="{Binding DurationMilliSeconds}" MinWidth="100"></DataGridTextColumn>
                        <DataGridTextColumn Header="DateComplete" Binding="{Binding DateComplete}" MinWidth="150"></DataGridTextColumn>
                        <DataGridTextColumn Header="IsComplete" Binding="{Binding IsComplete}" MinWidth="50"></DataGridTextColumn>
                        <DataGridTextColumn Header="LastRoute" Binding="{Binding LastRoute}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="OptimalRoute" Binding="{Binding OptimalRoute}" MinWidth="200"></DataGridTextColumn>
                        <DataGridTextColumn Header="CountTerminal" Binding="{Binding CountTerminal}" MinWidth="100"></DataGridTextColumn>
                        <DataGridTextColumn Header="BestValue" Binding="{Binding BestValue}" MinWidth="50"></DataGridTextColumn>
                        <DataGridTextColumn Header="UpdateOptcount" Binding="{Binding UpdateOptcount}" MinWidth="100"></DataGridTextColumn>
                        <DataGridTextColumn Header="ElemenationCount" Binding="{Binding ElemenationCount}" MinWidth="100"></DataGridTextColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Grid>

    </Grid>

</UserControl>
